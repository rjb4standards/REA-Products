{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://softwareassuranceguardian.com/schema/TrustDeclaration.schema.json",
  "title": "Trust Declaration Artifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "Metadata",
    "Statement"
  ],
  "properties": {
    "Metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subjectType",
        "subject",
        "RegPolicy",
        "statementType",
        "statementVersion"
      ],
      "properties": {
        "subjectType": {
          "type": "string",
          "format": "uri",
          "const": "https://softwareassuranceguardian.com/object-type/PUBCERT",
          "description": "Object type identifier."
        },
        "subject": {
          "type": "string",
          "pattern": "^ztdnaid:\\s[A-F0-9]{64}$",
          "description": "ZTDNA identifier of the subject."
        },
        "RegPolicy": {
          "type": "string",
          "pattern": "^ztdnaid:\\s[A-F0-9]{64}$",
          "description": "ZTDNA identifier of the governing regulatory policy."
        },
        "statementType": {
          "type": "string",
          "format": "uri",
          "const": "https://softwareassuranceguardian.com/statement-type/vnd.BCG.TrustDeclaration",
          "description": "Statement type identifier."
        },
        "statementVersion": {
          "type": "string",
          "const": "1.0",
          "description": "Schema version of the statement."
        }
      }
    },
    "Statement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ObjectDNAID",
        "EvidenceFileHash",
        "EvidenceFileName",
        "TrustLabelURL"
      ],
      "properties": {
        "ObjectDNAID": {
          "type": "string",
          "pattern": "^[A-F0-9]{64}$",
          "description": "SHA-256 Object DNA identifier."
        },
        "EvidenceFileHash": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$",
          "description": "SHA-256 hash of the supporting evidence file."
        },
        "EvidenceFileName": {
          "type": "string",
          "minLength": 1,
          "description": "Name of the evidence file."
        },
        "TrustLabelURL": {
          "type": "string",
          "format": "uri",
          "description": "URL of the generated trust label."
        }
      }
    }
  }
}